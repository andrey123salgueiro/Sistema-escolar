rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection (Diretora, Professores)
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // Question Sections
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isValidId(sectionId);
    }

    // Questions (Conselho de Classe questions)
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isValidId(questionId);
    }

    // Pre-Council Reports / Fichas
    match /reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    // Classes / Turmas
    match /classes/{classId} {
      allow read: if true;
      allow write: if isValidId(classId);
    }

    // Students / Alunos
    match /students/{studentId} {
      allow read: if true;
      allow write: if isValidId(studentId);
    }
  }
}
